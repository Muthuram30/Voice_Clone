# Copy to .env and edit. Never commit .env. No value here is required for the basic demo.

SECRET_KEY=change-me
SEED_DEFAULT_PROFILES=1          # create "User 1" / "User 2" on first start (any number of profiles can exist)

# ---- Gemini (OPTIONAL: text normalisation only; never generates audio) ----
GEMINI_API_KEY=
# Comma-separated, tried in order. Model names change; check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODELS=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20

# ---- TTS (XTTS-v2, pretrained; non-commercial Coqui Public Model License: https://coqui.ai/cpml) ----
COQUI_TOS_AGREED=1               # set to 1 ONLY after reading and accepting the licence
TTS_DEVICE=auto                  # auto | cpu | cuda
#   auto  = use CUDA if torch.cuda.is_available(), else CPU (default; never raises)
#   cuda  = require GPU; raises CudaNotAvailableError at startup if CUDA is absent
#   cpu   = always use CPU regardless of GPU presence
# Run:  .venv\Scripts\python.exe scripts\check_gpu.py  for a GPU diagnostic + XTTS benchmark.
# GPU VRAM notes (RTX 3050 Laptop, 4 GB):
#   XTTS-v2 weights: ~1.8 GB after load; peak during inference: ~1.9 GB.
#   If you see CUDA OOM, reduce MAX_TEXT_CHARS or set TTS_DEVICE=cpu.
XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# ---- Speaker encoder ----
ENCODER_BACKEND=auto             # auto (ECAPA if installed, else MFCC baseline) | ecapa | mfcc

# ---- DSP / MATLAB (OPTIONAL) ----
DSP_BACKEND=auto                 # auto | python | matlab   (python = never touch MATLAB)
MATLAB_MODE=auto                 # auto (Engine, else CLI) | engine | cli
MATLAB_EXE=                      # e.g. C:\Program Files\MATLAB\R2024b\bin\matlab.exe  (if not on PATH)
MATLAB_DESKTOP=0                 # 1 = show the MATLAB desktop when the Engine starts
TARGET_FS=16000

# ---- Enrollment validation ----
ENROLL_TARGET_SECONDS=120
ENROLL_MIN_SECONDS=60
ENROLL_MAX_SECONDS=300
ENROLL_MIN_SPEECH_SECONDS=40
ENROLL_MIN_SPEECH_RATIO=0.35
MAX_TEXT_CHARS=1500

