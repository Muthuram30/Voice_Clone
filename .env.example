# Copy this template only for a fresh installation. Preserve an existing .env.
SECRET_KEY=change-me
SEED_DEFAULT_PROFILES=1

# CUDA DSP and synthesis require an NVIDIA GPU with a compatible torch build.
TTS_DEVICE=cuda
XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
# Read https://coqui.ai/cpml and set to 1 only after accepting the licence.
COQUI_TOS_AGREED=0
# Full-shared FFmpeg bin folder, containing ffmpeg.exe and its DLLs.
FFMPEG_BIN_DIR=

# auto (try ECAPA, else labelled MFCC baseline) | ecapa | mfcc
ENCODER_BACKEND=auto
TARGET_FS=16000

# Gemini is optional: text preparation only. Enable per synthesis in the UI.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20

ENROLL_TARGET_SECONDS=120
ENROLL_MIN_SECONDS=60
ENROLL_MAX_SECONDS=300
ENROLL_MIN_SPEECH_SECONDS=40
ENROLL_MIN_SPEECH_RATIO=0.35
MAX_TEXT_CHARS=1500
SENTENCE_MAX_CHARS=200
